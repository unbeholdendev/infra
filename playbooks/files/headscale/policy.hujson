{
  "tagOwners": {
    "tag:router": ["unbeholden@"],
    "tag:giran": ["unbeholden@"]
  },
  "hosts": {
    "aden": "192.168.4.12/32"
  },
  "autoApprovers": {
    "routes": {
      "192.168.4.0/24": ["tag:router"],
      "192.168.5.2/32": ["tag:router"],
      "192.168.6.0/24": ["tag:router"]
    },
    "exitNode": ["tag:router"]
  },
  "acls": [
    { "action": "accept", "src": ["tag:giran"], "dst": [
      "aden:7233", // lnurl
      "192.168.4.200:443",
      "192.168.4.200:222",
      "aden:5123", // ntfy
      "aden:3123", // umami
      "aden:4123", // lofik
      "aden:8472", // calrs
      "aden:5637", // book
      "aden:5233", // radicale via its own proxy listener
    ] },
    { "action": "accept", "src": ["amberdust@"], "dst": [
      "aden:443",             // cal, vw via the proxy
      "192.168.5.2:30041",    // immich
      "192.168.5.2:445",      // truenas smb
      "100.64.0.1:53",        // tailnet DNS
      "autogroup:internet:*", // exit node
    ] },
    { "action": "accept", "src": ["unbeholden@"], "dst": ["*:*"] }
  ]
}
